<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="900.0" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VistaController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <Label text="Sistema de Ventas">
        <font>
            <Font size="20.0" />
        </font>
    </Label>

    <HBox spacing="15.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Productos" />
            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="140.0" text="Producto" />
                    <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Cantidad:" />
                <TextField fx:id="txtCantidad" prefWidth="80.0" />
                <Button fx:id="btnAgregar" onAction="#handleAgregar" text="Agregar al carrito" />
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Carrito" />
            <ListView fx:id="lstCarrito" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label text="Total:" />
        <Label fx:id="lblTotal" text="\$ 0.0" />
        <Button fx:id="btnConfirmar" onAction="#handleConfirmar" text="Confirmar compra" />
    </HBox>
</VBox>
